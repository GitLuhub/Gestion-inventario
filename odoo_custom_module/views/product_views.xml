<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_template_form_inventory" model="ir.ui.view">
            <field name="name">product.template.form.inventory</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='inventory']" position="before">
                    <page name="inventory_advanced" string="Stock y Almacén">
                        <group col="4">
                            <group string="Niveles de Stock">
                                <field name="min_stock_level"/>
                                <field name="max_stock_level"/>
                            </group>
                            <group string="Información">
                                <field name="manufacturer_ref"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="view_product_product_tree_inventory" model="ir.ui.view">
            <field name="name">product.product.tree.inventory</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_product_tree_view"/>
            <field name="arch" type="xml">
                <field name="standard_price" position="after">
                    <field name="qty_available" optional="show"/>
                </field>
            </field>
        </record>

        <record id="view_product_brand_form" model="ir.ui.view">
            <field name="name">product.brand.form</field>
            <field name="model">product.brand</field>
            <field name="arch" type="xml">
                <form string="Marca de Producto">
                    <sheet>
                        <group col="4">
                            <group>
                                <field name="name"/>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="logo" widget="image" class="oe_avatar"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Productos" name="products">
                                <field name="product_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_product_brand_tree" model="ir.ui.view">
            <field name="name">product.brand.tree</field>
            <field name="model">product.brand</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="product_count"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="action_product_brand" model="ir.actions.act_window">
            <field name="name">Marcas de Productos</field>
            <field name="res_model">product.brand</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- menu_product_brand is defined in menu_views.xml under the custom module root menu -->
    </data>
</odoo>
