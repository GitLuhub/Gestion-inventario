<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_stock_location_form_inventory" model="ir.ui.view">
            <field name="name">stock.location.form.inventory</field>
            <field name="model">stock.location</field>
            <field name="inherit_id" ref="stock.view_location_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='usage']" position="after">
                    <field name="location_type"/>
                </xpath>
                <xpath expr="//group[@name='group_forecasted_stocks']" position="inside">
                    <group string="Capacidad">
                        <field name="max_capacity"/>
                        <field name="current_capacity" readonly="1"/>
                        <field name="capacity_usage_percent" readonly="1"/>
                    </group>
                </xpath>
                <xpath expr="//field[@name='comment']" position="before">
                    <group col="2">
                        <group string="Clasificación">
                            <field name="usage_class"/>
                            <field name="temperature_range"/>
                        </group>
                        <group string="Gestión">
                            <field name="barcode"/>
                            <field name="responsible_id"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="view_stock_location_tree_inventory" model="ir.ui.view">
            <field name="name">stock.location.tree.inventory</field>
            <field name="model">stock.location</field>
            <field name="inherit_id" ref="stock.view_location_tree"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="location_type"/>
                    <field name="capacity_usage_percent" optional="hide"/>
                    <field name="responsible_id" optional="show"/>
                </field>
            </field>
        </record>

        <record id="view_stock_quant_form_inventory" model="ir.ui.view">
            <field name="name">stock.quant.form.inventory</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lot_id']" position="after">
                    <field name="lot_expiration_date" readonly="1"/>
                    <field name="incoming_date" readonly="1"/>
                </xpath>
                <xpath expr="//field[@name='quantity']" position="attributes">
                    <attribute name="readonly">0</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_stock_quant_tree_inventory" model="ir.ui.view">
            <field name="name">stock.quant.tree.inventory</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree"/>
            <field name="arch" type="xml">
                <field name="lot_id" position="after">
                    <field name="lot_expiration_date" optional="show"/>
                    <field name="is_expired" optional="show"/>
                </field>
            </field>
        </record>

        <record id="view_stock_inventory_form_inventory" model="ir.ui.view">
            <field name="name">stock.inventory.form.inventory</field>
            <field name="model">stock.inventory</field>
            <field name="inherit_id" ref="stock.view_inventory_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date']" position="after">
                    <field name="adjustment_type"/>
                    <field name="responsible_id"/>
                </xpath>
                <xpath expr="//field[@name='note']" position="replace">
                    <field name="notes" placeholder="Notas adicionales..."/>
                </xpath>
                <xpath expr="//field[@name='state']" position="replace">
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,done"/>
                </xpath>
            </field>
        </record>

        <record id="view_stock_inventory_line_tree_inventory" model="ir.ui.view">
            <field name="name">stock.inventory.line.tree.inventory</field>
            <field name="model">stock.inventory.line</field>
            <field name="inherit_id" ref="stock.view_inventory_line_tree"/>
            <field name="arch" type="xml">
                <field name="product_qty" position="after">
                    <field name="theoretical_qty" readonly="1"/>
                    <field name="difference_qty" readonly="1"/>
                    <field name="adjustment_reason"/>
                </field>
            </field>
        </record>

        <record id="view_stock_inventory_line_form_inventory" model="ir.ui.view">
            <field name="name">stock.inventory.line.form.inventory</field>
            <field name="model">stock.inventory.line</field>
            <field name="inherit_id" ref="stock.view_inventory_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_qty']" position="after">
                    <field name="theoretical_qty" readonly="1"/>
                    <field name="difference_qty" readonly="1"/>
                    <field name="adjustment_reason"/>
                    <field name="notes"/>
                </xpath>
            </field>
        </record>

        <record id="action_stock_location_type" model="ir.actions.act_window">
            <field name="name">Ubicaciones por Tipo</field>
            <field name="res_model">stock.location</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'group_by': 'location_type'}</field>
            <field name="domain">[('usage', '=', 'internal')]</field>
        </record>

        <menuitem id="menu_stock_location_type"
                  name="Por Tipo"
                  parent="stock.menu_stock_inventory_control"
                  action="action_stock_location_type"
                  sequence="6"/>

        <record id="action_expired_quants" model="ir.actions.act_window">
            <field name="name">Productos Vencidos</field>
            <field name="res_model">stock.quant</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_filter_is_expired': 1}</field>
            <field name="domain">[('is_expired', '=', True), ('quantity', '>', 0)]</field>
        </record>

        <menuitem id="menu_expired_quants"
                  name="Vencidos"
                  parent="stock.menu_stock_inventory_control"
                  action="action_expired_quants"
                  sequence="7"/>
    </data>
</odoo>
