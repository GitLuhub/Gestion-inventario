<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <menuitem id="menu_inventory_custom_root"
                  name="Inventario Avanzado"
                  sequence="10"
                  groups="stock.group_stock_manager"/>

        <menuitem id="menu_inventory_custom_products"
                  name="Productos"
                  parent="menu_inventory_custom_root"
                  sequence="1"
                  groups="stock.group_stock_user"/>

        <menuitem id="menu_inventory_custom_locations"
                  name="Ubicaciones"
                  parent="menu_inventory_custom_root"
                  sequence="2"
                  groups="stock.group_stock_user"/>

        <menuitem id="menu_inventory_custom_operations"
                  name="Operaciones"
                  parent="menu_inventory_custom_root"
                  sequence="3"
                  groups="stock.group_stock_user"/>

        <menuitem id="menu_inventory_custom_reports"
                  name="Informes"
                  parent="menu_inventory_custom_root"
                  sequence="4"
                  groups="stock.group_stock_manager"/>

        <menuitem id="menu_inventory_custom_configuration"
                  name="Configuración"
                  parent="menu_inventory_custom_root"
                  sequence="99"
                  groups="stock.group_stock_manager"/>

        <record id="action_low_stock_products" model="ir.actions.act_window">
            <field name="name">Productos con Stock Bajo</field>
            <field name="res_model">product.product</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_filter_low_stock': 1}</field>
            <field name="domain">[('type', '=', 'product'), ('qty_available', '&lt;=', 'min_stock_level')]</field>
            <field name="help">
                <p class="o_view_nocontent_smiling_face">
                    No hay productos con stock bajo
                </p>
                <p>
                    Los productos aparecen aquí cuando su cantidad disponible es menor o igual al nivel mínimo configurado.
                </p>
            </field>
        </record>

        <menuitem id="menu_low_stock_products"
                  name="Stock Bajo"
                  parent="menu_inventory_custom_products"
                  action="action_low_stock_products"
                  sequence="10"/>

        <record id="action_stock_by_location" model="ir.actions.act_window">
            <field name="name">Stock por Ubicación</field>
            <field name="res_model">stock.quant</field>
            <field name="view_mode">pivot,tree</field>
            <field name="context">{'search_default_group_by_location': 1}</field>
            <field name="help">
                <p class="o_view_nocontent_smiling_face">
                    No hay datos de stock
                </p>
                <p>
                    Consulta el stock de productos por ubicación.
                </p>
            </field>
        </record>

        <menuitem id="menu_stock_by_location"
                  name="Stock por Ubicación"
                  parent="menu_inventory_custom_reports"
                  action="action_stock_by_location"
                  sequence="10"/>

        <record id="action_inventory_adjustment_history" model="ir.actions.act_window">
            <field name="name">Historial de Ajustes</field>
            <field name="res_model">stock.inventory</field>
            <field name="view_mode">tree,form,calendar,pivot</field>
            <field name="context">{'search_default_adjustment_type': 1}</field>
            <field name="help">
                <p class="o_view_nocontent_smiling_face">
                    No hay ajustes de inventario
                </p>
                <p>
                    Los ajustes de inventario aparecerán aquí cuando se validen.
                </p>
            </field>
        </record>

        <menuitem id="menu_inventory_adjustment_history"
                  name="Historial de Ajustes"
                  parent="menu_inventory_custom_reports"
                  action="action_inventory_adjustment_history"
                  sequence="20"/>

        <record id="action_stock_valuation" model="ir.actions.act_window">
            <field name="name">Valoración de Inventario</field>
            <field name="res_model">product.product</field>
            <field name="view_mode">tree,form,pivot</field>
            <field name="context">{
                'search_default_filter_to_report': 1,
                'search_default_group_by_categ_id': 1
            }</field>
        </record>

        <menuitem id="menu_stock_valuation"
                  name="Valoración"
                  parent="menu_inventory_custom_reports"
                  action="action_stock_valuation"
                  sequence="30"/>
    </data>
</odoo>
