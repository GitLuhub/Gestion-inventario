<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de lista para Ajustes de Inventario -->
        <record id="view_stock_inventory_adjustment_tree" model="ir.ui.view">
            <field name="name">stock.inventory.adjustment.tree</field>
            <field name="model">stock.inventory.adjustment</field>
            <field name="arch" type="xml">
                <tree decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-warning="state == 'in_progress'">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="adjustment_type"/>
                    <field name="state" widget="badge"/>
                </tree>
            </field>
        </record>

        <!-- Vista de formulario para Ajustes de Inventario -->
        <record id="view_stock_inventory_adjustment_form" model="ir.ui.view">
            <field name="name">stock.inventory.adjustment.form</field>
            <field name="model">stock.inventory.adjustment</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_start" string="Iniciar" type="object" class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_validate" string="Validar" type="object" class="btn-success" invisible="state != 'in_progress'"/>
                        <button name="action_cancel" string="Cancelar" type="object" invisible="state in ('done', 'cancel')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Información General">
                                <field name="name" readonly="1"/>
                                <field name="date"/>
                                <field name="adjustment_type"/>
                                <field name="reason_id"/>
                                <field name="responsible_id"/>
                            </group>
                            <group string="Ubicaciones">
                                <field name="location_ids" widget="many2many_tags"
                                       domain="[('usage', '=', 'internal'), ('company_id', 'in', [False, company_id])]"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes"/>
                        </group>
                        <group string="Resumen de Discrepancias">
                            <field name="total_discrepancy" readonly="1"/>
                            <field name="total_surplus" readonly="1"/>
                            <field name="total_shortage" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Líneas de Ajuste" name="lines">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="product_id"/>
                                        <field name="location_id"/>
                                        <field name="current_qty" readonly="1"/>
                                        <field name="expected_qty"/>
                                        <field name="difference_qty" readonly="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista de búsqueda -->
        <record id="view_stock_inventory_adjustment_search" model="ir.ui.view">
            <field name="name">stock.inventory.adjustment.search</field>
            <field name="model">stock.inventory.adjustment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="responsible_id"/>
                    <filter string="Borrador" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Validados" name="done" domain="[('state', '=', 'done')]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Acción para Ajustes de Inventario -->
        <record id="action_stock_inventory_adjustment" model="ir.actions.act_window">
            <field name="name">Ajustes de Inventario</field>
            <field name="res_model">stock.inventory.adjustment</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_draft': 1}</field>
            <field name="help" type="html">
                <p>No hay ajustes. Cree uno nuevo para registrar diferencias de stock.</p>
            </field>
        </record>

        <!-- Wizard de Ajuste Rápido -->
        <record id="view_stock_inventory_wizard_form" model="ir.ui.view">
            <field name="name">stock.inventory.wizard.form</field>
            <field name="model">stock.inventory.wizard</field>
            <field name="arch" type="xml">
                <form string="Ajuste Rápido de Inventario">
                    <group>
                        <group string="Producto">
                            <field name="location_id"/>
                            <field name="product_id"/>
                        </group>
                        <group string="Cantidades">
                            <field name="current_qty" readonly="1"/>
                            <field name="new_qty"/>
                            <field name="difference_qty" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason_id"/>
                    </group>
                    <footer>
                        <button name="action_apply" string="Aplicar" type="object" class="btn-primary"/>
                        <button string="Cancelar" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_stock_inventory_wizard" model="ir.actions.act_window">
            <field name="name">Ajuste Rápido</field>
            <field name="res_model">stock.inventory.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Wizard de Conteo Rápido -->
        <record id="view_stock_inventory_quick_count_form" model="ir.ui.view">
            <field name="name">stock.inventory.quick.count.form</field>
            <field name="model">stock.inventory.quick.count</field>
            <field name="arch" type="xml">
                <form string="Conteo Rápido">
                    <group>
                        <field name="location_id"/>
                    </group>
                    <group>
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="product_id" readonly="1"/>
                                <field name="current_qty" readonly="1"/>
                                <field name="counted_qty"/>
                                <field name="difference" readonly="1"/>
                            </tree>
                        </field>
                    </group>
                    <footer>
                        <button name="action_validate" string="Validar" type="object" class="btn-primary"/>
                        <button string="Cancelar" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_stock_inventory_quick_count" model="ir.actions.act_window">
            <field name="name">Conteo Rápido</field>
            <field name="res_model">stock.inventory.quick.count</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Razones de Ajuste -->
        <record id="view_stock_inventory_adjustment_reason_tree" model="ir.ui.view">
            <field name="name">stock.inventory.adjustment.reason.tree</field>
            <field name="model">stock.inventory.adjustment.reason</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="sequence"/>
                    <field name="name"/>
                    <field name="description"/>
                </tree>
            </field>
        </record>

        <record id="action_stock_inventory_adjustment_reason" model="ir.actions.act_window">
            <field name="name">Razones de Ajuste</field>
            <field name="res_model">stock.inventory.adjustment.reason</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Secuencia -->
        <record id="seq_stock_inventory_adjustment" model="ir.sequence">
            <field name="name">Ajuste de Inventario</field>
            <field name="code">stock.inventory.adjustment</field>
            <field name="prefix">ADJ/</field>
            <field name="padding">5</field>
        </record>

        <!-- Los menús se definen en menu_views.xml -->
    </data>
</odoo>
