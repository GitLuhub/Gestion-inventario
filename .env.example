# ===================================================================
# CONFIGURACIÓN DE ENTORNO - Sistema de Gestión de Inventario
# ===================================================================
# Copia este archivo a .env y ajusta los valores según tu entorno
# ===================================================================

# -----------------------------------------------------------------------------
# CONFIGURACIÓN GENERAL
# -----------------------------------------------------------------------------
TZ=America/Venezuela
COMPOSE_PROJECT_NAME=inventory_system
COMPOSE_FILE=docker-compose.yml

# -----------------------------------------------------------------------------
# CONTRASEÑAS Y SECRETOS (NO COMMITEAR AL GIT)
# -----------------------------------------------------------------------------
# Estas contraseñas deben estar en los archivos de secretos
# Ver: secrets/*.txt

# -----------------------------------------------------------------------------
# POSTGRESQL
# -----------------------------------------------------------------------------
POSTGRES_DB=odoo_db
POSTGRES_USER=odoo
# POSTGRES_PASSWORD se lee desde secrets/db_password.txt

# -----------------------------------------------------------------------------
# ODOO
# -----------------------------------------------------------------------------
ODOO_VERSION=16.0
ODOO_PORT=8069
# ODOO_MASTER_PASSWORD se lee desde secrets/odoo_master_password.txt
ODOO_LOGLEVEL=info
ODOO_WORKERS=2
ODOO_MAX_CRON_THREADS=1
ODOO_LIMIT_TIME_CPU=600
ODOO_LIMIT_TIME_REAL=1200
ODOO_LIMIT_REQUEST=8192

# -----------------------------------------------------------------------------
# ETL SERVICE
# -----------------------------------------------------------------------------
ODOO_URL=http://odoo_app:8069
ODOO_DB=odoo_db
ODOO_USER=etl_user
# ODOO_PASSWORD se lee desde secrets/odoo_etl_user_password.txt

# Fuentes de datos externas
EXTERNAL_API_URL=http://external-api:8080/api/v1
# EXTERNAL_API_KEY se lee desde secrets/external_api_key.txt

# Configuración del ETL
ETL_DATA_PATH=/app/data
ETL_LOG_LEVEL=INFO
ETL_SCHEDULE_CRON=*/15 * * * *
ETL_BATCH_SIZE=100
ETL_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# API GATEWAY
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# JWT_SECRET_KEY se lee desde secrets/jwt_secret_key.txt

# -----------------------------------------------------------------------------
# FRONTEND
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Gestión de Inventario
NODE_ENV=development

# -----------------------------------------------------------------------------
# NGINX
# -----------------------------------------------------------------------------
NGINX_PORT_HTTP=80
NGINX_PORT_HTTPS=443

# -----------------------------------------------------------------------------
# MONITOREO
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# RUTAS LOCALES
# -----------------------------------------------------------------------------
DATA_PATH=./data
LOGS_PATH=./logs
