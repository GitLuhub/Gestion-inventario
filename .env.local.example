# ===============================================
# Environment Configuration - Local Development
# ===============================================
# Copy this file to .env.local and adjust values

# Odoo Configuration
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_db
ODOO_USER=admin
ODOO_PASSWORD=admin
ODOO_MASTER_PASSWORD=admin_dev

# ETL Service
ETL_DATA_PATH=/app/data
ETL_LOG_LEVEL=DEBUG
ETL_SCHEDULE_CRON=*/15 * * * *

# API Gateway
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=DEBUG
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Gestión de Inventario (Dev)"
NODE_ENV=development

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=odoo_db
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_dev
